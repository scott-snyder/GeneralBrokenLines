set(PACKAGE_VERSION "@GBL_VERSION@")
if(NOT "${PACKAGE_FIND_VERSION}" VERSION_GREATER "@GBL_VERSION@")
  set(PACKAGE_VERSION_COMPATIBLE 1) # compatible with older
  if("${PACKAGE_FIND_VERSION}" VERSION_EQUAL "@GBL_VERSION@")
    set(PACKAGE_VERSION_EXACT 1) # exact match for this version
  endif()
endif()
